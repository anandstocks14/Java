import java.util.Scanner;

/**
 * A Java program to calculate the factorial of a given number.
 */
public class FactorialCalculator {

    public static void main(String[] args) {
        // Create a Scanner object for user input
        Scanner scanner = new Scanner(System.in);

        System.out.print("Enter a non-negative integer: ");

        if (scanner.hasNextInt()) {
            int number = scanner.nextInt();

            if (number < 0) {
                System.out.println("Error: Factorial is not defined for negative numbers.");
            } else {
                // Calculate and print the factorial
                long result = calculateFactorial(number);
                System.out.println("The factorial of " + number + " is: " + result);
            }
        } else {
            System.out.println("Error: Invalid input. Please enter an integer.");
        }

        // Close the scanner to prevent resource leaks
        scanner.close();
    }

    /**
     * Calculates the factorial of a non-negative integer iteratively.
     * @param n The number to calculate the factorial for (n >= 0).
     * @return The factorial of n as a long.
     */
    public static long calculateFactorial(int n) {
        // Use long to avoid overflow for numbers up to 20!
        long factorial = 1;

        // Loop from 1 to n, multiplying at each step
        for (int i = 1; i <= n; i++) {
            factorial *= i; // Equivalent to factorial = factorial * i;
        }

        return factorial;
    }
}
